BOT_TOKEN=YOUR_BOT_TOKEN
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Telegram API credentials from my.telegram.org
API_ID=123456
API_HASH=YOUR_API_HASH

# Generated once by the setup script; DO NOT put your Telegram password here.
USER_SESSION_STRING=PASTE_SESSION_STRING_HERE

# 1 or 2 supergroup IDs, comma separated.
ALLOWED_GROUP_IDS=-1001234567890,-1009876543210

# Path to the Python voice worker.
VOICE_WORKER=voice/voice_worker.py
